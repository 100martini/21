generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  intraId          Int?      @unique
  login            String    @unique
  displayName      String?
  email            String?
  password         String?
  bio              String?
  avatar           String?
  nickname         String?
  customAvatar     String?
  accessToken      String?
  campus           String?
  level            Float     @default(0)
  wallet           Int       @default(0)
  correctionPoints Int       @default(0)
  curriculum       String    @default("old")
  grade            String    @default("Cadet")
  currentCircle    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdTeams           Team[]         @relation("TeamCreator")
  teamMemberships        TeamMember[]
  userProjects           UserProject[]
  deleteRequests         DeleteRequest[]
  deleteApprovals        DeleteApproval[]
  sentFriendRequests     Friendship[]   @relation("FriendRequester")
  receivedFriendRequests Friendship[]   @relation("FriendAddressee")
  createdCards           Card[]         @relation("CardCreator")
  assignedCards          Card[]         @relation("CardAssignee")
  createdProjects        Project[]      @relation("CreatedProjects")

  @@index([intraId])
  @@index([login])
  @@index([curriculum])
  @@index([nickname])
}

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

model Curriculum {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String
  createdAt   DateTime @default(now())

  projectCurricula ProjectCurriculum[]
}

model Project {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  name          String
  description   String?
  circle        Int
  minTeam       Int       @default(1)
  maxTeam       Int       @default(1)
  isOuterCore   Boolean   @default(false)
  isUserCreated Boolean   @default(false)
  deadline      DateTime?
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy        User?              @relation("CreatedProjects", fields: [createdById], references: [id])
  projectCurricula ProjectCurriculum[]
  teams            Team[]
  userProjects     UserProject[]
  boards           Board[]

  @@index([slug])
  @@index([circle])
  @@index([isOuterCore])
  @@index([isUserCreated])
  @@index([createdById])
}

model ProjectCurriculum {
  id           Int  @id @default(autoincrement())
  projectId    Int
  curriculumId Int
  circle       Int?

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([projectId, curriculumId])
  @@index([projectId])
  @@index([curriculumId])
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  projectId Int
  creatorId Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator       User           @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  deleteRequest DeleteRequest?

  @@index([projectId])
  @@index([creatorId])
  @@index([status])
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([status])
}

model UserProject {
  id        Int      @id @default(autoincrement())
  userId    Int
  projectId Int
  status    String
  validated Boolean  @default(false)
  finalMark Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model DeleteRequest {
  id          Int      @id @default(autoincrement())
  teamId      Int      @unique
  requesterId Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requester User             @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  approvals DeleteApproval[]

  @@index([teamId])
  @@index([requesterId])
  @@index([status])
}

model DeleteApproval {
  id              Int      @id @default(autoincrement())
  deleteRequestId Int
  userId          Int
  approved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  deleteRequest DeleteRequest @relation(fields: [deleteRequestId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deleteRequestId, userId])
  @@index([deleteRequestId])
  @@index([userId])
}

model Board {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns     Column[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Column {
  id        Int      @id @default(autoincrement())
  name      String
  position  Int
  boardId   Int
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, position])
}

model Card {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  position    Int
  columnId    Int
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creatorId   Int?
  creator     User?     @relation("CardCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  assignee    User?     @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  priority    String?   @default("medium")
  labels      Label[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([columnId, position])
}

model Label {
  id    Int    @id @default(autoincrement())
  name  String
  color String
  cards Card[]
}
